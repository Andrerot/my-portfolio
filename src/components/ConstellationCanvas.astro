---
// ConstellationCanvas.astro - Accurate Circumpolar Sky with Dynamic Viewport & Zoom Scaling
---
<canvas id="celestial-canvas" class="celestial-canvas" aria-hidden="true"></canvas>

<style>
  .celestial-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.95;
  }
</style>

<script>
  function initCelestialCanvas() {
    const canvas = document.getElementById("celestial-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let width = 0;
    let height = 0;
    let dpr = 1;

    // Mouse parallax variables
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    // Star data structure with normalized coordinates (u, v in 0..1)
    interface Star {
      u: number;
      v: number;
      radius: number;
      color: string;
      alpha: number;
      baseAlpha: number;
      speed: number;
    }

    let bgStars: Star[] = [];
    const starPalette = ["#FFFFFF", "#E0E7FF", "#BAE6FD", "#FEF08A", "#DDD6FE"];

    function generateStars(count: number): Star[] {
      return Array.from({ length: count }, () => {
        const baseAlpha = Math.random() * 0.7 + 0.2;
        return {
          u: Math.random(),
          v: Math.random(),
          radius: Math.random() < 0.82 ? Math.random() * 1.1 + 0.4 : Math.random() * 1.8 + 1.2,
          color: starPalette[Math.floor(Math.random() * starPalette.length)],
          alpha: baseAlpha,
          baseAlpha,
          speed: Math.random() * 0.02 + 0.005,
        };
      });
    }

    function resize() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      width = rect.width || window.innerWidth;
      height = rect.height || window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.resetTransform();
      ctx.scale(dpr, dpr);

      // Recalculate star count dynamically based on the current width & height (handles zoom-in and zoom-out)
      const targetStarCount = Math.max(140, Math.floor((width * height) / 4800));
      if (bgStars.length < targetStarCount) {
        bgStars = generateStars(targetStarCount);
      }
    }

    resize();
    mouseX = targetX = width / 2;
    mouseY = targetY = height / 2;

    window.addEventListener("resize", resize);
    window.addEventListener("mousemove", (e) => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
    });

    // 2. Real Astronomical Coordinates (Right Ascension in degrees, Declination in degrees)
    // Polaris: Celestial Pole at Dec = +89.3°
    // Ursa Major & Cassiopeia are real circumpolar constellations on opposite sides of Polaris (Delta RA ~ 180° / 12h)
    const ASTRO_DATA = {
      ursaMajor: [
        { name: "Alkaid", ra: 206.9, dec: 49.3, mag: 1.85 },
        { name: "Mizar",  ra: 200.9, dec: 54.9, mag: 2.23 },
        { name: "Alioth", ra: 193.5, dec: 55.9, mag: 1.76 },
        { name: "Megrez", ra: 183.9, dec: 57.0, mag: 3.32 },
        { name: "Phecda", ra: 176.9, dec: 53.7, mag: 2.41 },
        { name: "Merak",  ra: 165.5, dec: 56.4, mag: 2.34 }, // Pointer star 1
        { name: "Dubhe",  ra: 165.9, dec: 61.8, mag: 1.79 }, // Pointer star 2
      ],
      cassiopeia: [
        { name: "Caph",    ra: 2.3,   dec: 59.2, mag: 2.28 },
        { name: "Schedar", ra: 10.1,  dec: 56.5, mag: 2.24 },
        { name: "Navi",    ra: 14.2,  dec: 60.7, mag: 2.15 },
        { name: "Ruchbah", ra: 21.4,  dec: 60.2, mag: 2.68 },
        { name: "Segin",   ra: 28.6,  dec: 63.7, mag: 3.35 },
      ],
    };

    let time = 0;

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Smooth mouse parallax
      mouseX += (targetX - mouseX) * 0.04;
      mouseY += (targetY - mouseY) * 0.04;
      const offsetX = ((mouseX - width / 2) / width) * 20;
      const offsetY = ((mouseY - height / 2) / height) * 20;

      time += 0.02;

      // 1. Draw Milky Way diffuse galactic stardust (faint nebula glow across Cassiopeia)
      const isMobile = width < 768;
      const heroReservedWidth = isMobile ? 0 : Math.min(width * 0.42, 500);
      const skyAreaWidth = width - heroReservedWidth;

      // Adaptive Polaris Center: centered on mobile, right-aligned on desktop
      const polX = isMobile
        ? width * 0.5 + offsetX * 0.4
        : heroReservedWidth + skyAreaWidth * 0.52 + offsetX * 0.7;

      const polY = isMobile
        ? height * 0.28 + offsetY * 0.4
        : height * 0.48 + offsetY * 0.7;

      // Scale (pixels per celestial degree) bounded safely for both mobile and desktop
      const maxRadiusDeg = 44;
      const maxAllowedVertical = isMobile ? height * 0.24 : height * 0.38;
      const maxAllowedHorizontal = isMobile ? (width / 2) * 0.85 : (skyAreaWidth / 2) * 0.78;
      const pxPerDeg = Math.max(
        isMobile ? 2.2 : 2.8,
        Math.min(5.5, Math.min(maxAllowedVertical, maxAllowedHorizontal) / maxRadiusDeg)
      );

      // Draw faint galactic nebula glow around Cassiopeia & upper sky
      const milkyGrad = ctx.createRadialGradient(
        polX + 70, polY - 100, 20,
        polX + 70, polY - 100, Math.min(width * 0.6, 450)
      );
      milkyGrad.addColorStop(0, "rgba(59, 130, 246, 0.07)");
      milkyGrad.addColorStop(0.5, "rgba(99, 102, 241, 0.03)");
      milkyGrad.addColorStop(1, "rgba(7, 11, 20, 0)");
      ctx.beginPath();
      ctx.arc(polX + 70, polY - 100, Math.min(width * 0.6, 450), 0, Math.PI * 2);
      ctx.fillStyle = milkyGrad;
      ctx.fill();

      // 2. Draw Uniform Background Starfield across 100% of the canvas
      bgStars.forEach((s) => {
        const twinkle = Math.sin(time * s.speed * 70) * 0.25;
        const currentAlpha = Math.max(0.1, Math.min(1, s.baseAlpha + twinkle));
        const px = s.u * width + offsetX * 0.25;
        const py = s.v * height + offsetY * 0.25;

        ctx.beginPath();
        ctx.arc(px, py, s.radius, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = currentAlpha;
        ctx.fill();
      });
      ctx.globalAlpha = 1;

      // 3. Astronomical Sky Projection (Italy ~41°N, viewing North)
      // Sky rotation calibrated so Cassiopeia is in the upper quadrant and Ursa Major in the lower quadrant
      const skyRotation = (-45 * Math.PI) / 180;

      function projectStar(raDeg: number, decDeg: number) {
        const r = (90 - decDeg) * pxPerDeg;
        const theta = (raDeg * Math.PI) / 180 + skyRotation;
        return {
          x: polX + r * Math.cos(theta),
          y: polY + r * Math.sin(theta),
        };
      }

      const umPoints = ASTRO_DATA.ursaMajor.map((s) => ({
        ...projectStar(s.ra, s.dec),
        name: s.name,
        mag: s.mag,
      }));

      const casPoints = ASTRO_DATA.cassiopeia.map((s) => ({
        ...projectStar(s.ra, s.dec),
        name: s.name,
        mag: s.mag,
      }));

      // --- Draw faint Celestial Reference Dec Parallel ---
      ctx.beginPath();
      ctx.strokeStyle = "rgba(59, 130, 246, 0.1)";
      ctx.lineWidth = 1;
      ctx.arc(polX, polY, 30 * pxPerDeg, 0, Math.PI * 2);
      ctx.stroke();

      // --- URSA MAJOR (The Big Dipper / Il Grande Carro) ---
      ctx.beginPath();
      ctx.strokeStyle = "rgba(147, 197, 253, 0.45)";
      ctx.lineWidth = 1.3;
      // Handle: Alkaid(0) -> Mizar(1) -> Alioth(2) -> Megrez(3)
      ctx.moveTo(umPoints[0].x, umPoints[0].y);
      ctx.lineTo(umPoints[1].x, umPoints[1].y);
      ctx.lineTo(umPoints[2].x, umPoints[2].y);
      ctx.lineTo(umPoints[3].x, umPoints[3].y);
      // Bowl: Megrez(3) -> Phecda(4) -> Merak(5) -> Dubhe(6) -> Megrez(3)
      ctx.lineTo(umPoints[4].x, umPoints[4].y);
      ctx.lineTo(umPoints[5].x, umPoints[5].y);
      ctx.lineTo(umPoints[6].x, umPoints[6].y);
      ctx.lineTo(umPoints[3].x, umPoints[3].y);
      ctx.stroke();

      // --- THE POINTER LINE: Merak (5) -> Dubhe (6) -> POLARIS ---
      // Authentic ~5.3x Pointer Beam
      ctx.beginPath();
      ctx.setLineDash([4, 6]);
      ctx.strokeStyle = "rgba(250, 204, 21, 0.7)";
      ctx.lineWidth = 1.4;
      ctx.moveTo(umPoints[5].x, umPoints[5].y); // Merak
      ctx.lineTo(umPoints[6].x, umPoints[6].y); // Dubhe
      ctx.lineTo(polX, polY);                    // Polaris
      ctx.stroke();
      ctx.setLineDash([]);

      // --- CASSIOPEIA (The Queen, 'W' Shape) ---
      // Caph(0) -> Schedar(1) -> Navi(2) -> Ruchbah(3) -> Segin(4)
      ctx.beginPath();
      ctx.strokeStyle = "rgba(147, 197, 253, 0.45)";
      ctx.lineWidth = 1.3;
      ctx.moveTo(casPoints[0].x, casPoints[0].y);
      for (let i = 1; i < casPoints.length; i++) {
        ctx.lineTo(casPoints[i].x, casPoints[i].y);
      }
      ctx.stroke();

      // Cassiopeia's guide line towards Polaris
      ctx.beginPath();
      ctx.setLineDash([3, 6]);
      ctx.strokeStyle = "rgba(167, 139, 250, 0.5)";
      ctx.lineWidth = 1.1;
      ctx.moveTo(casPoints[2].x, casPoints[2].y); // Navi
      ctx.lineTo(polX, polY);
      ctx.stroke();
      ctx.setLineDash([]);

      // --- Draw Star Dots (Ursa Major + Cassiopeia) with Magnitude-scaled glow ---
      const allStars = [...umPoints, ...casPoints];
      allStars.forEach((star) => {
        const radius = Math.max(1.8, 3.8 - star.mag * 0.5);

        // Ambient star glow
        ctx.beginPath();
        ctx.arc(star.x, star.y, radius * 2.8, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(96, 165, 250, 0.28)";
        ctx.fill();

        // Core star
        ctx.beginPath();
        ctx.arc(star.x, star.y, radius, 0, Math.PI * 2);
        ctx.fillStyle = "#FFFFFF";
        ctx.fill();
      });

      // --- POLARIS (The North Star) ---
      const pulse = Math.sin(time * 2.2) * 0.25 + 0.85;

      // Golden & Cyan pulsar nebula
      const polGrad = ctx.createRadialGradient(polX, polY, 2, polX, polY, 32 * pulse);
      polGrad.addColorStop(0, "rgba(250, 204, 21, 0.95)");
      polGrad.addColorStop(0.35, "rgba(59, 130, 246, 0.45)");
      polGrad.addColorStop(0.7, "rgba(59, 130, 246, 0.15)");
      polGrad.addColorStop(1, "rgba(59, 130, 246, 0)");
      ctx.beginPath();
      ctx.arc(polX, polY, 32 * pulse, 0, Math.PI * 2);
      ctx.fillStyle = polGrad;
      ctx.fill();

      // 4-point diffraction spike flare
      ctx.beginPath();
      ctx.strokeStyle = `rgba(255, 255, 255, ${0.6 * pulse})`;
      ctx.lineWidth = 1.2;
      ctx.moveTo(polX - 18 * pulse, polY);
      ctx.lineTo(polX + 18 * pulse, polY);
      ctx.moveTo(polX, polY - 18 * pulse);
      ctx.lineTo(polX, polY + 18 * pulse);
      ctx.stroke();

      // Polaris core
      ctx.beginPath();
      ctx.arc(polX, polY, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = "#FFFBEB";
      ctx.fill();

      // Constellation & Polaris Typography Labels (clean, non-cluttering)
      if (!isMobile) {
        ctx.font = "600 12px system-ui, sans-serif";
        ctx.fillStyle = "rgba(250, 204, 21, 0.9)";
        ctx.fillText("POLARIS", polX + 14, polY - 8);
        ctx.font = "400 10px system-ui, sans-serif";
        ctx.fillStyle = "rgba(148, 163, 184, 0.85)";
        ctx.fillText("The North Star · Celestial Pole", polX + 14, polY + 6);

        // Constellation labels
        ctx.font = "600 11px system-ui, sans-serif";
        ctx.fillStyle = "rgba(147, 197, 253, 0.75)";
        ctx.fillText("URSA MAJOR", umPoints[5].x - 15, umPoints[5].y + 24);
        ctx.font = "400 9.5px system-ui, sans-serif";
        ctx.fillStyle = "rgba(148, 163, 184, 0.65)";

        ctx.font = "600 11px system-ui, sans-serif";
        ctx.fillStyle = "rgba(147, 197, 253, 0.75)";
        ctx.fillText("CASSIOPEIA", casPoints[1].x - 15, casPoints[1].y - 18);
      }

      // --- 4. Interactive Starlight Shockwave Beacon on Proximity ---
      const interactiveTargets = [
        { name: "POLARIS", x: polX, y: polY, info: "Celestial Pole · RA 02h 31m" },
        { name: "DUBHE", x: umPoints[6].x, y: umPoints[6].y, info: "Pointer Star · α UMa" },
        { name: "MERAK", x: umPoints[5].x, y: umPoints[5].y, info: "Pointer Star · β UMa" },
        { name: "ALKAID", x: umPoints[0].x, y: umPoints[0].y, info: "Handle Tip · η UMa" },
        { name: "SCHEDAR", x: casPoints[1].x, y: casPoints[1].y, info: "Heart of Queen · α Cas" },
      ];

      let activeTarget = null;
      for (const t of interactiveTargets) {
        if (Math.hypot(targetX - t.x, targetY - t.y) < 32) {
          activeTarget = t;
          break;
        }
      }

      if (activeTarget && !reduceMotion) {
        // Expanding shockwave ripple ring
        const ringProgress = (time * 2.5) % 1; // 0 to 1
        const ringRadius = 6 + ringProgress * 30;
        const ringAlpha = (1 - ringProgress) * 0.8;

        ctx.beginPath();
        ctx.arc(activeTarget.x, activeTarget.y, ringRadius, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(147, 197, 253, ${ringAlpha})`;
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Scientific HUD Badge
        const tagW = 125;
        const tagH = 34;
        const tagX = Math.min(width - tagW - 10, activeTarget.x + 14);
        const tagY = Math.max(10, activeTarget.y - 17);

        ctx.fillStyle = "rgba(15, 23, 42, 0.88)";
        ctx.strokeStyle = "rgba(59, 130, 246, 0.55)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        // Support roundRect or fallback to rect
        if (typeof ctx.roundRect === "function") {
          ctx.roundRect(tagX, tagY, tagW, tagH, 6);
        } else {
          ctx.rect(tagX, tagY, tagW, tagH);
        }
        ctx.fill();
        ctx.stroke();

        ctx.font = "700 11px system-ui, sans-serif";
        ctx.fillStyle = "#F8FAFC";
        ctx.fillText(activeTarget.name, tagX + 8, tagY + 14);

        ctx.font = "400 9px system-ui, sans-serif";
        ctx.fillStyle = "#93C5FD";
        ctx.fillText(activeTarget.info, tagX + 8, tagY + 26);
      }

      if (!reduceMotion) {
        requestAnimationFrame(render);
      }
    }

    render();
  }

  initCelestialCanvas();
  document.addEventListener("astro:page-load", initCelestialCanvas);
</script>
