---
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery";
import ConstellationCanvas from "../components/ConstellationCanvas.astro";

const name = "Andrea Montillo";
const letters = [...name];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const experiences = [
  {
    company: "CCH Tagetik",
    role: "Product Software Engineer",
    period: "Mar 2024 — Present",
    highlights: [
      "Architecting and developing mission-critical cloud solutions and enterprise full-stack applications.",
      "Guaranteeing top-tier security, microservice stability, and continuous horizontal scalability.",
      "Designing resilient microservices using modern backend technologies and cloud-native paradigms.",
    ],
  },
  {
    company: "Deloitte Consulting",
    role: "Consultant — Software Engineering",
    period: "Feb 2021 — Feb 2024",
    highlights: [
      "Engineered microservices architectures and distributed applications using Python, SpringBoot, and Angular.",
      "Containerized software products with Kubernetes and Helm, drastically improving deployment frequency and infrastructure resilience.",
      "Worked with both relational (MySQL) and document-oriented databases (MongoDB) for high-performance data processing.",
      "Mentored junior engineers, managed task subdivision, and established architectural best practices.",
    ],
  },
  {
    company: "University of Salerno (DIEM)",
    role: "M.Sc. & B.Sc. in Computer Engineering",
    period: "2015 — 2021",
    highlights: [
      "Master's Degree in Computer Engineering: Final grade 110/110 with honors (cum laude).",
      "Bachelor's Degree in Computer Engineering: Final grade 110/110 with honors (cum laude).",
      "In-depth research and coursework across Machine Learning, Cybersecurity, Information Theory, and Distributed Algorithms.",
    ],
  },
];

const skillCategories = [
  {
    title: "Languages",
    icon: "💻",
    items: "Python, Java, TypeScript, JavaScript, SQL, C++, GDScript",
  },
  {
    title: "Backend & Architecture",
    icon: "⚙️",
    items: "SpringBoot, REST APIs, Microservices, Node.js, Next.js, JPA / Hibernate",
  },
  {
    title: "Cloud & DevOps",
    icon: "☁️",
    items: "AWS (Certified Cloud Practitioner), Kubernetes, Helm, Docker, CI/CD, Git, Linux",
  },
  {
    title: "Frontend & Web Tech",
    icon: "🎨",
    items: "Angular, React, Astro, Tailwind CSS, Kinetic Animations (GSAP & Lenis)",
  },
  {
    title: "Databases & Storage",
    icon: "🗄️",
    items: "MySQL, MongoDB, PostgreSQL, Document & Relational Modeling",
  },
  {
    title: "Agentic AI & Indie Lab",
    icon: "🤖",
    items: "Autonomous Coding Agents, LLM Tooling, Godot 4 Game Engine, Mobile APK Prototyping",
  },
];
---

<Layout
  title={`${name} — Software Engineer`}
  description="Software Engineer with a Master's degree (110 cum laude) specializing in Cloud, Microservices, and Agentic AI workflows."
>
  <!-- Site Header -->
  <header class="site-header">
    <div class="wrap">
      <a href="#top" class="brand">
        <span>{name}</span>
        <span class="brand-badge">SWE</span>
      </a>
      <nav aria-label="Main Navigation">
        <a href="#philosophy" class="nav-link">Philosophy</a>
        <a href="#experience" class="nav-link">Experience</a>
        <a href="#projects" class="nav-link">Projects</a>
        <a href="#skills" class="nav-link">Skills</a>
        <a href="#contact" class="btn" style="padding: 0.45rem 1rem; font-size: 0.85rem;">Get in Touch</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- Hero Section with Celestial Constellations Canvas -->
    <section class="hero">
      <ConstellationCanvas />

      <div class="wrap">
        <div class="hero-content">
          <div class="hero-status">
            <span class="status-dot"></span>
            <span>Product Software Engineer @ CCH Tagetik · Navigating with AI Agents</span>
          </div>

          <h1 aria-label={name}>
            {letters.map((ch) => (
              <span data-letter aria-hidden="true">
                {ch === " " ? "\u00A0" : ch}
              </span>
            ))}
          </h1>

          <p class="hero-bio">
            Computer Engineer passionate about distributed systems, resilient cloud architectures, and navigating the new frontier of software development through <strong>autonomous AI agent workflows</strong>.
          </p>

          <div class="hero-actions">
            <a class="btn" href="#projects">
              <span>Explore Projects</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn-secondary" href="#experience">
              <span>View Experience</span>
            </a>
            <a class="btn-secondary" href={`${base}/cv.pdf`} target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Resume (PDF)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The North Star Principle (Engineering Philosophy & AI Shift) -->
    <section class="block" id="philosophy">
      <div class="wrap">
        <div class="section-label">
          <span>✨</span>
          <span>The North Star Principle</span>
        </div>
        <h2 class="section-title">Mindset & Problem Clarity Over Raw Syntax</h2>

        <div class="northstar-banner">
          <div class="northstar-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span>Navigating the 2026 AI Era</span>
          </div>

          <h3>In the age of AI, attitude and systemic vision are the true differentiator.</h3>

          <p>
            Vertical syntax memorization is no longer the bottleneck of software engineering. With intelligent AI agents capable of generating, refactoring, and debugging implementations at lighting speed, an engineer's true value lies in <strong>holistic problem comprehension</strong>: grasping real functional and business requirements, decomposing complex distributed systems, and maintaining an relentlessly proactive mindset.
          </p>

          <p>
            High emotional intelligence, adaptability, clear communication, and architectural responsibility matter far more than knowing one specific framework by heart. AI multiplies capability, but human attitude defines direction.
          </p>

          <div class="northstar-quote">
            "Just as navigators rely on Ursa Major and Cassiopeia to pinpoint Polaris in the dark sky, technology stacks and frameworks revolve — but clear problem solving, intellectual curiosity, and strong soft skills remain the constant North Star."
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="block" id="experience">
      <div class="wrap">
        <div class="section-label">
          <span>🪐</span>
          <span>Career Journey</span>
        </div>
        <h2 class="section-title">Work Experience & Education</h2>

        <div class="timeline">
          {experiences.map((exp) => (
            <div class="timeline-item">
              <div>
                <div class="timeline-date">{exp.period}</div>
                <h3 class="timeline-company">{exp.company}</h3>
                <div class="timeline-role">{exp.role}</div>
              </div>
              <div>
                <ul class="timeline-bullets">
                  {exp.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section with Interactive React Island -->
    <section class="block" id="projects">
      <div class="wrap">
        <div class="section-label">
          <span>🚀</span>
          <span>Selected Work & Experiments</span>
        </div>
        <h2 class="section-title">Engineering Projects & Indie Lab</h2>

        <p class="text-[#94A3B8] text-lg max-w-2xl mb-8">
          From enterprise distributed architectures and autonomous AI tooling to indie game prototypes in Godot and personal utilities.
        </p>

        <!-- React Island with Category Filtering & Spotlight Effect -->
        <ProjectGallery client:visible />
      </div>
    </section>

    <!-- Skills Section with AI Multiplier Callout -->
    <section class="block" id="skills">
      <div class="wrap">
        <div class="section-label">
          <span>⚡</span>
          <span>Core Competencies</span>
        </div>
        <h2 class="section-title">Technical Launchpad & The AI Multiplier</h2>

        <div class="skills-grid mb-8">
          {skillCategories.map((cat) => (
            <div class="skill-box">
              <h3>
                <span>{cat.icon}</span>
                <span>{cat.title}</span>
              </h3>
              <p>{cat.items}</p>
            </div>
          ))}
        </div>

        <!-- AI Multiplier Callout -->
        <div class="p-6 rounded-xl border border-[#3B82F6]/30 bg-[#0F172A]/90 shadow-lg shadow-blue-500/5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xl">🌌</span>
            <span class="font-bold text-[#60A5FA] text-sm uppercase tracking-wider">
              Limitless Stack Adaptability via AI Agents
            </span>
          </div>
          <p class="text-[#94A3B8] text-[0.98rem] leading-relaxed m-0">
            The technologies above represent my everyday foundation. However, thanks to a solid grounding in Computer Science (algorithms, protocols, distributed paradigms) coupled with <strong class="text-[#F8FAFC]">autonomous AI agent workflows</strong>, adapting to any new language, tool, or cloud provider is virtually immediate. Tools are variable; engineering discipline is universal.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact CTA Section -->
    <section class="block" id="contact">
      <div class="wrap">
        <div class="contact-card">
          <h2>Let's build something extraordinary.</h2>
          <p>
            Always excited to discuss distributed systems, architectural challenges, and autonomous AI engineering.
          </p>
          <div class="contact-links">
            <a class="btn" href="mailto:and.montillo@gmail.com">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>and.montillo@gmail.com</span>
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="btn-secondary cursor-pointer"
              aria-label="Copy email address"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span id="copy-email-text">Copy Email</span>
            </button>
            <a class="btn-secondary" href="https://linkedin.com/in/andreamontillo" target="_blank" rel="noopener noreferrer">
              <span>LinkedIn Profile ↗</span>
            </a>
            <a class="btn-secondary" href="https://github.com/Andrerot" target="_blank" rel="noopener noreferrer">
              <span>GitHub ↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Site Footer -->
  <footer>
    <div class="wrap">
      <div>
        © {new Date().getFullYear()} Andrea Montillo. All rights reserved.
      </div>
      <div>
        Celestial Engineering · Built with Astro, React, Tailwind v4 & GSAP
      </div>
    </div>
  </footer>

  <script>
    import "../scripts/motion.ts";

    // Copy email handler
    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-email-text");
    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("and.montillo@gmail.com");
          copyText.textContent = "Copied to clipboard! ✓";
          setTimeout(() => {
            copyText.textContent = "Copy Email";
          }, 2500);
        } catch {
          window.location.href = "mailto:and.montillo@gmail.com";
        }
      });
    }
  </script>
</Layout>
