---
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery";

const name = "Andrea Montillo";
const letters = [...name];

const experiences = [
  {
    company: "CCH Tagetik",
    role: "Product Software Engineer",
    period: "Mar 2024 — Present",
    highlights: [
      "Architecting and developing mission-critical cloud solutions and enterprise full-stack applications.",
      "Guaranteeing top-tier security, microservice stability, and continuous horizontal scalability.",
      "Designing resilient microservices using modern backend technologies and cloud-native paradigms.",
    ],
  },
  {
    company: "Deloitte Consulting",
    role: "Consultant — Software Engineering",
    period: "Feb 2021 — Feb 2024",
    highlights: [
      "Engineered microservices architectures and distributed applications using Python, SpringBoot, and Angular.",
      "Containerized software products with Kubernetes and Helm, drastically improving deployment frequency and infrastructure resilience.",
      "Worked with both relational (MySQL) and document-oriented databases (MongoDB) for high-performance data processing.",
      "Mentored junior engineers, managed task subdivision, and established architectural best practices.",
    ],
  },
  {
    company: "University of Salerno (DIEM)",
    role: "M.Sc. & B.Sc. in Computer Engineering",
    period: "2015 — 2021",
    highlights: [
      "Master's Degree in Computer Engineering: Final grade 110/110 with honors (cum laude).",
      "Bachelor's Degree in Computer Engineering: Final grade 110/110 with honors (cum laude).",
      "In-depth research and coursework across Machine Learning, Cybersecurity, Information Theory, and Distributed Algorithms.",
    ],
  },
];

const skillCategories = [
  {
    title: "Languages",
    icon: "💻",
    items: "Python, Java, TypeScript, JavaScript, SQL, C++, GDScript",
  },
  {
    title: "Backend & Architecture",
    icon: "⚙️",
    items: "SpringBoot, REST APIs, Microservices, Node.js, Next.js, JPA / Hibernate",
  },
  {
    title: "Cloud & DevOps",
    icon: "☁️",
    items: "AWS (Certified Cloud Practitioner), Kubernetes, Helm, Docker, CI/CD, Git, Linux",
  },
  {
    title: "Frontend & Web Tech",
    icon: "🎨",
    items: "Angular, React, Astro, Tailwind CSS, Kinetic Animations (GSAP & Lenis)",
  },
  {
    title: "Databases & Storage",
    icon: "🗄️",
    items: "MySQL, MongoDB, PostgreSQL, Document & Relational Modeling",
  },
  {
    title: "Agentic AI & Indie Lab",
    icon: "🤖",
    items: "Autonomous Coding Agents, LLM Tooling, Godot 4 Game Engine, Mobile APK Prototyping",
  },
];
---

<Layout
  title={`${name} — Software Engineer`}
  description="Software Engineer with a Master's degree (110 cum laude) specializing in Cloud, Microservices, and Agentic AI workflows."
>
  <!-- Site Header -->
  <header class="site-header">
    <div class="wrap">
      <a href="#top" class="brand">
        <span>{name}</span>
        <span class="brand-badge">SWE</span>
      </a>
      <nav aria-label="Main Navigation">
        <a href="#about" class="nav-link">About</a>
        <a href="#experience" class="nav-link">Experience</a>
        <a href="#projects" class="nav-link">Projects</a>
        <a href="#skills" class="nav-link">Skills</a>
        <a href="#contact" class="btn" style="padding: 0.45rem 1rem; font-size: 0.85rem;">Get in Touch</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- Hero Section -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-status">
          <span class="status-dot"></span>
          <span>Product Software Engineer @ CCH Tagetik · Building with AI Agents</span>
        </div>

        <h1 aria-label={name}>
          {letters.map((ch) => (
            <span data-letter aria-hidden="true">
              {ch === " " ? "\u00A0" : ch}
            </span>
          ))}
        </h1>

        <p class="hero-bio">
          Computer Engineer with a Master's degree (110 <em>cum laude</em>). Passionate about architecting scalable microservices, cloud-native systems, and pushing the boundaries of software development through <strong>autonomous AI agent workflows</strong>.
        </p>

        <div class="hero-actions">
          <a class="btn" href="#projects">
            <span>Explore Projects</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn-secondary" href="#experience">
            <span>View Experience</span>
          </a>
          <a class="btn-secondary" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Resume (PDF)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- About & Engineering Philosophy -->
    <section class="block" id="about">
      <div class="wrap">
        <div class="section-label">Engineering Ethos</div>
        <h2 class="section-title">Bridging Rigorous Engineering with Next-Gen AI</h2>

        <div class="agentic-banner">
          <div class="agentic-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            <span>The 2026 Shift: Agentic Development</span>
          </div>
          <h3>Software engineering is evolving — and I build with it.</h3>
          <p>
            From high-throughput distributed systems at Deloitte and CCH Tagetik to autonomous agentic workflows, I believe the future belongs to engineers who combine deep foundational knowledge (distributed systems, security, information theory) with autonomous AI tooling. This entire portfolio was co-engineered live using autonomous agent workflows, proving speed, precision, and modern craftsmanship.
          </p>
        </div>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="block" id="experience">
      <div class="wrap">
        <div class="section-label">Career Journey</div>
        <h2 class="section-title">Work Experience & Education</h2>

        <div class="timeline">
          {experiences.map((exp) => (
            <div class="timeline-item">
              <div>
                <div class="timeline-date">{exp.period}</div>
                <h3 class="timeline-company">{exp.company}</h3>
                <div class="timeline-role">{exp.role}</div>
              </div>
              <div>
                <ul class="timeline-bullets">
                  {exp.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section with Interactive React Island -->
    <section class="block" id="projects">
      <div class="wrap">
        <div class="section-label">Selected Work & Experiments</div>
        <h2 class="section-title">Engineering Projects & Indie Lab</h2>

        <p class="text-[#475467] text-lg max-w-2xl mb-8">
          From enterprise distributed architectures and autonomous AI tooling to indie game prototypes in Godot and personal utilities.
        </p>

        <!-- React Island with Category Filtering & Spotlight Effect -->
        <ProjectGallery client:visible />
      </div>
    </section>

    <!-- Skills Section -->
    <section class="block" id="skills">
      <div class="wrap">
        <div class="section-label">Toolkit</div>
        <h2 class="section-title">Technical Competencies</h2>

        <div class="skills-grid">
          {skillCategories.map((cat) => (
            <div class="skill-box">
              <h3>
                <span>{cat.icon}</span>
                <span>{cat.title}</span>
              </h3>
              <p>{cat.items}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact CTA Section -->
    <section class="block" id="contact">
      <div class="wrap">
        <div class="contact-card">
          <h2>Let's build something extraordinary.</h2>
          <p>
            I am always open to discussing distributed architectures, engineering opportunities, and autonomous AI systems.
          </p>
          <div class="contact-links">
            <a class="btn" href="mailto:and.montillo@gmail.com">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>and.montillo@gmail.com</span>
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="btn-secondary cursor-pointer"
              aria-label="Copy email address"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span id="copy-email-text">Copy Email</span>
            </button>
            <a class="btn-secondary" href="https://linkedin.com/in/andreamontillo" target="_blank" rel="noopener noreferrer">
              <span>LinkedIn Profile ↗</span>
            </a>
            <a class="btn-secondary" href="https://github.com/andreamontillo" target="_blank" rel="noopener noreferrer">
              <span>GitHub ↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Site Footer -->
  <footer>
    <div class="wrap">
      <div>
        © {new Date().getFullYear()} Andrea Montillo. All rights reserved.
      </div>
      <div>
        Engineered with Astro, React, Tailwind v4 & GSAP · Edge-hosted on Cloudflare
      </div>
    </div>
  </footer>

  <script>
    import "../scripts/motion.ts";

    // Copy email handler
    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-email-text");
    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("and.montillo@gmail.com");
          copyText.textContent = "Copied to clipboard! ✓";
          setTimeout(() => {
            copyText.textContent = "Copy Email";
          }, 2500);
        } catch {
          window.location.href = "mailto:and.montillo@gmail.com";
        }
      });
    }
  </script>
</Layout>
